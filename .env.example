# Copy to .env.local and fill in real values. .env.local is gitignored —
# never commit real secrets. See docs/02-architecture.md for what each
# service is for.

# Payload — long random string, used to sign sessions/tokens
PAYLOAD_SECRET=

# Neon (Postgres) connection string
DATABASE_URI=postgresql://user:password@host/dbname?sslmode=require

# Resend (transactional email: auth emails, event confirmations, receipts)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=no-reply@justbelieveintmissions.org

# Platform root domain for tenant subdomains, e.g. tenant "jbim" resolves
# from jbim.jbim-platform.app — see src/middleware.ts
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=jbim-platform.app

# --- npm run seed (src/seed/run.ts) — idempotent, safe to re-run ---
SEED_TENANT_NAME=Just Believe International Missions
SEED_TENANT_SLUG=jbim
SEED_TENANT_DOMAIN=justbelieveintmissions.org
# Optional — if omitted, roles/permissions still seed, just create your
# first admin at /admin instead:
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# --- Not yet wired into payload.config.ts — added when their collections/
# integrations are built (see docs/00-decisions-log.md, docs/02-architecture.md) ---

# Cloudflare R2 (S3-compatible media storage)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=

# PayPal (per-tenant client IDs live in the Tenants collection instead —
# these would be platform-level app credentials if ever needed)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
